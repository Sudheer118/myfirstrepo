{
	"name": "df_type2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "wssynapseflm89-WorkspaceDefaultStorage",
						"type": "LinkedServiceReference"
					},
					"name": "sourceemptype2"
				},
				{
					"linkedService": {
						"referenceName": "AzureSqlDatabase1",
						"type": "LinkedServiceReference"
					},
					"name": "targetsqltype2"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureSqlDatabase1",
						"type": "LinkedServiceReference"
					},
					"name": "updatesink"
				},
				{
					"linkedService": {
						"referenceName": "AzureSqlDatabase1",
						"type": "LinkedServiceReference"
					},
					"name": "insertsink"
				}
			],
			"transformations": [
				{
					"name": "hashcol"
				},
				{
					"name": "select"
				},
				{
					"name": "join"
				},
				{
					"name": "split1"
				},
				{
					"name": "updateaudit"
				},
				{
					"name": "alterRowupdate"
				},
				{
					"name": "auditcoloumnsource"
				},
				{
					"name": "union"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as short,",
				"          name as string,",
				"          city as string,",
				"          salary as integer",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'input',",
				"     folderPath: 'employee',",
				"     fileName: 'emptype2.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> sourceemptype2",
				"source(output(",
				"          tgt_empid as integer,",
				"          tgt_hashcol as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'query',",
				"     store: 'sqlserver',",
				"     query: 'select empid as tgt_empid , hashcol as tgt_hashcol from EMPSCDTYPE2\\nwhere isactive =1',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> targetsqltype2",
				"sourceemptype2 derive(hashcol = crc32(id,name,city,salary)) ~> hashcol",
				"hashcol select(mapColumn(",
				"          each(match(1==1),",
				"               concat('src_',$$) = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"select, targetsqltype2 join(src_id == tgt_empid,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join",
				"join split(isNull(tgt_empid),",
				"     src_id==tgt_empid && src_hashcol!=tgt_hashcol,",
				"     disjoint: false) ~> split1@(insert, update)",
				"split1@update derive(updatedate = currentTimestamp(),",
				"          updateby = 'dataflow_updated',",
				"          src_isactive = 0) ~> updateaudit",
				"updateaudit alterRow(updateIf(1==1)) ~> alterRowupdate",
				"union derive(src_createdate = currentTimestamp(),",
				"          src_updatedate = currentTimestamp(),",
				"          src_updateby = 'dataflow',",
				"          src_createby = 'dataflow',",
				"          src_active = 1) ~> auditcoloumnsource",
				"split1@insert, split1@update union(byName: true)~> union",
				"alterRowupdate sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EMPID as integer,",
				"          EMPNAME as string,",
				"          EMPSAL as long,",
				"          EMPCITY as string,",
				"          CREATEDDATE as timestamp,",
				"          UPDATEEDDATE as timestamp,",
				"          CREATEDBY as string,",
				"          UPDATEDBY as string,",
				"          HASHCOL as long,",
				"          ISACTIVE as integer",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'EMPSCDTYPE2',",
				"     insertable: false,",
				"     updateable: true,",
				"     deletable: false,",
				"     upsertable: false,",
				"     keys:['EMPID','HASHCOL'],",
				"     stagingSchemaName: '',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EMPID = tgt_empid,",
				"          EMPNAME = src_name,",
				"          EMPSAL = src_salary,",
				"          EMPCITY = src_city,",
				"          UPDATEEDDATE = updatedate,",
				"          UPDATEDBY = updateby,",
				"          HASHCOL = src_hashcol,",
				"          ISACTIVE = src_isactive",
				"     )) ~> updatesink",
				"auditcoloumnsource sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EMPID as integer,",
				"          EMPNAME as string,",
				"          EMPSAL as long,",
				"          EMPCITY as string,",
				"          CREATEDDATE as timestamp,",
				"          UPDATEEDDATE as timestamp,",
				"          CREATEDBY as string,",
				"          UPDATEDBY as string,",
				"          HASHCOL as long,",
				"          ISACTIVE as integer",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'EMPSCDTYPE2',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     stagingSchemaName: '',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          EMPID = tgt_empid,",
				"          UPDATEEDDATE = src_updatedate,",
				"          UPDATEDBY = src_updateby,",
				"          HASHCOL = tgt_hashcol,",
				"          ISACTIVE = src_active",
				"     )) ~> insertsink"
			]
		}
	}
}